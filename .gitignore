# Composer
composer.lock
/vendor

# Local-only manifest that pins Nova to a mirrored copy. Used to keep working
# while the Nova license credentials are being renewed; never committed.
/composer-dev.json
/composer-dev.lock

# Node
/node_modules
npm-debug.log
yarn-error.log

# NOTE: dist/ is deliberately committed. A Nova tool is unusable without its
# compiled bundle, and with no CI to build one on release the repository has to
# carry it. Run `composer build-assets` before tagging — 1.x shipped a bundle
# months out of step with its source, so this is the thing to get wrong.

# Generated from the committed templates
/phpstan.neon
/phpunit.xml

# Caches and reports
/build
/coverage
.phpunit.cache
.phpunit.result.cache

# Credentials
auth.json

# IDE
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
/.idea
/.fleet
/.vscode
