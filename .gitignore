# Composer
composer.lock
/vendor

# Local-only manifest that pins Nova to a mirrored copy. Used to keep working
# while the Nova license credentials are being renewed; never committed.
/composer-dev.json
/composer-dev.lock

# Node
/node_modules
npm-debug.log
yarn-error.log

# Built tool assets. Produced by `npm run build` and attached on release, so
# they are never committed from a developer machine — 1.x shipped a bundle that
# was months out of step with its source because of exactly that.
/dist

# Generated from the committed templates
/phpstan.neon
/phpunit.xml

# Caches and reports
/build
/coverage
.phpunit.cache
.phpunit.result.cache

# Credentials
auth.json

# IDE
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
/.idea
/.fleet
/.vscode
