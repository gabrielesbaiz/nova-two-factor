{
    "name": "gabrielesbaiz/nova-two-factor",
    "description": "Two-factor authentication for Laravel Nova: authenticator apps, passkeys, email codes, recovery codes, enforcement policies, step-up re-authentication and admin oversight.",
    "keywords": [
        "laravel",
        "nova",
        "two-factor",
        "2fa",
        "mfa",
        "totp",
        "webauthn",
        "passkeys",
        "security"
    ],
    "license": "MIT",
    "homepage": "https://github.com/gabrielesbaiz/nova-two-factor",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele.sbaiz@noviasnet.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "bacon/bacon-qr-code": "^3.0",
        "illuminate/support": "^11.0|^12.0",
        "laravel/fortify": "^1.25.4",
        "pragmarx/google2fa": "^8.0|^9.0",
        "spatie/laravel-package-tools": "^1.16",
        "web-auth/webauthn-lib": "^5.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "laravel/nova": "5.7.*",
        "laravel/nova-devtool": "^1.8",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^9.0|^10.0",
        "orchestra/workbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.4"
    },
    "conflict": {
        "laravel/nova": "<5.7.0|>=6.0.0"
    },
    "suggest": {
        "ext-sodium": "Required to verify Ed25519 (-8) passkey signatures."
    },
    "autoload": {
        "psr-4": {
            "Gabrielesbaiz\\NovaTwoFactor\\": "src/",
            "Gabrielesbaiz\\NovaTwoFactor\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrielesbaiz\\NovaTwoFactor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ],
        "format": "@php vendor/bin/pint --ansi",
        "analyse": "@php vendor/bin/phpstan analyse --verbose --ansi",
        "test": "@php vendor/bin/pest",
        "test-coverage": "@php vendor/bin/pest --coverage --min=90",
        "build-assets": [
            "npm ci",
            "npm run build",
            "@php scripts/check-assets.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrielesbaiz\\NovaTwoFactor\\NovaTwoFactorServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
