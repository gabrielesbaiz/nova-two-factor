# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Keep development-only files out of the Composer dist archive. `dist/` is
# deliberately NOT ignored here: the compiled tool bundle is the one build
# artifact a consumer genuinely needs.
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.github                export-ignore
/.gitignore             export-ignore
/.prettierrc            export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/pint.json              export-ignore
/resources/css          export-ignore
/resources/js           export-ignore
/testbench.yaml         export-ignore
/tests                  export-ignore
/vite.config.js         export-ignore
/workbench              export-ignore
